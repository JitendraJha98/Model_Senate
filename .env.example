# Primary recommended route: one OpenRouter key unlocks many models.
OPENROUTER_API_KEY=sk-or-v1-your-key

# Optional direct provider keys. Leave blank if you only use OpenRouter.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# Optional app settings.
MODEL_SENATE_HOST=127.0.0.1
MODEL_SENATE_PORT=8001
FRONTEND_ORIGIN=http://localhost:5173
# Optional: when set, paid endpoints (senate/council run, /v1/chat/completions)
# require `Authorization: Bearer <token>`. Leave blank to keep the API open (LAN dev).
API_AUTH_TOKEN=

# Model Council settings.
ORCHESTRATOR_MODEL_ID=openrouter-gpt-5-2
ORCHESTRATOR_PROVIDER=openrouter
COUNCIL_MIN_MODELS=2
COUNCIL_SYNTHESIS_RETRY_ON_FAILURE=true
# Max model turns per opinion when tools are used (results are fed back each turn).
COUNCIL_MAX_TOOL_ITERATIONS=3
# Multi-round debate (Stage 2.5): models revise after critique until convergence.
COUNCIL_DEBATE_ENABLED=true
COUNCIL_DEBATE_MAX_ROUNDS=2
COUNCIL_DEBATE_RECRITIQUE=true
COUNCIL_DEBATE_CONVERGENCE=self_report

# Run a council of LOCAL models (Ollama / LM Studio / vLLM) with ZERO API keys.
# Each route sets base_url to an OpenAI-compatible endpoint; no key required.
# MODEL_SENATE_ROUTES='[
#   {"id":"ollama-llama3","provider":"openai","model":"llama3.1","display_name":"Llama 3.1 (local)","base_url":"http://localhost:11434/v1"},
#   {"id":"ollama-qwen","provider":"openai","model":"qwen2.5","display_name":"Qwen 2.5 (local)","base_url":"http://localhost:11434/v1"},
#   {"id":"ollama-mistral","provider":"openai","model":"mistral","display_name":"Mistral (local)","base_url":"http://localhost:11434/v1"}
# ]'

# Reliability: request timeout, transient-failure retries, and global concurrency cap.
PROVIDER_TIMEOUT_SECONDS=90
PROVIDER_MAX_RETRIES=2
MAX_CONCURRENT_REQUESTS=8

# Optional tools. Disabled by default.
TOOL_WEB_SEARCH_ENABLED=false
TOOL_WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
TOOL_CODE_EXECUTOR_ENABLED=false
TOOL_CODE_EXECUTOR_TIMEOUT_SECONDS=10
